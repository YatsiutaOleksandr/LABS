<Window x:Class="LAB3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Android Calculator" Height="620" Width="360"
        ResizeMode="NoResize"
        Background="#202124">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,24,14,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="4"
                    VerticalAlignment="Bottom"
                    Margin="10,0,10,20">

            <TextBlock x:Name="TxtExpression"
                       FontSize="20"
                       Foreground="#9AA0A6"
                       TextAlignment="Right"/>

            <TextBlock x:Name="TxtDisplay"
                       Text="0"
                       FontSize="64"
                       Foreground="#E8EAED"
                       FontWeight="Light"
                       TextAlignment="Right"/>
        </StackPanel>

        <Button Grid.Row="1" Grid.Column="0" Content="C" Background="#5F6368" Click="OnClear"/>
        <Button Grid.Row="1" Grid.Column="1" Content="±" Background="#5F6368" Click="OnToggleSign"/>
        <Button Grid.Row="1" Grid.Column="2" Content="%" Background="#5F6368" Click="OnPercent"/>
        <Button Grid.Row="1" Grid.Column="3" Content="÷" Background="#81C995" Foreground="#202124" Click="OnOperator"/>

        <Button Grid.Row="2" Grid.Column="0" Content="7" Background="#3C4043" Click="OnDigit"/>
        <Button Grid.Row="2" Grid.Column="1" Content="8" Background="#3C4043" Click="OnDigit"/>
        <Button Grid.Row="2" Grid.Column="2" Content="9" Background="#3C4043" Click="OnDigit"/>
        <Button Grid.Row="2" Grid.Column="3" Content="×" Background="#81C995" Foreground="#202124" Click="OnOperator"/>

        <Button Grid.Row="3" Grid.Column="0" Content="4" Background="#3C4043" Click="OnDigit"/>
        <Button Grid.Row="3" Grid.Column="1" Content="5" Background="#3C4043" Click="OnDigit"/>
        <Button Grid.Row="3" Grid.Column="2" Content="6" Background="#3C4043" Click="OnDigit"/>
        <Button Grid.Row="3" Grid.Column="3" Content="−" Background="#81C995" Foreground="#202124" Click="OnOperator"/>

        <Button Grid.Row="4" Grid.Column="0" Content="1" Background="#3C4043" Click="OnDigit"/>
        <Button Grid.Row="4" Grid.Column="1" Content="2" Background="#3C4043" Click="OnDigit"/>
        <Button Grid.Row="4" Grid.Column="2" Content="3" Background="#3C4043" Click="OnDigit"/>
        <Button Grid.Row="4" Grid.Column="3" Content="+" Background="#81C995" Foreground="#202124" Click="OnOperator"/>

        <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="0" Background="#3C4043" Click="OnDigit"/>
        <Button Grid.Row="5" Grid.Column="2" Content="." Background="#3C4043" Click="OnDecimal"/>
        <Button Grid.Row="5" Grid.Column="3" Content="=" Background="#A8DAB5" Foreground="#202124" Click="OnEquals"/>
    </Grid>
</Window>